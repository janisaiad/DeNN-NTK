\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:correction_vs_depth}{{1}{34}{Spectral radius of the correction term $M(K_{\text {emp}} - K_{\infty })$ versus network depth $L$, plotted on a log-log scale. Different curves correspond to different widths $M$. The observed trend confirms that the correction grows with depth and scales inversely with width}{figure.caption.1}{}}
