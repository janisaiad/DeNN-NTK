\@writefile{toc}{\contentsline {subsection}{\numberline {13.2}The NTK Bulk Spectrum Obeys GOE Statistics}{68}{subsection.13.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Empirical distribution of the ratio of consecutive eigenvalue spacings in the bulk of the NTK, for $N=64$ points, dimension $D=10$, $M=20$ width, and $L=2$ layers. The empirical histogram (blue) is perfectly fitted by the theoretical prediction from the Gaussian Orthogonal Ensemble (red curve, Equation[]~\eqref  {eq:goe_ratio_dist}). This confirms that the NTK exhibits strong level repulsion characteristic of the GOE. The mode of the curve is at $r=1$, which is the expected value for the GOE. The reader can see that the curve put a hole exactly at the mode, further experiments have confirmed that adding the largest eigenvalue spacing ratios fill the hole since $\frac  {\lambda _1-\lambda _2}{\lambda _2-\lambda _3}$ is very near to 1. }}{69}{figure.caption.6}\protected@file@percent }
\newlabel{fig:goe_spacing_ratio_empirical}{{6}{69}{Empirical distribution of the ratio of consecutive eigenvalue spacings in the bulk of the NTK, for $N=64$ points, dimension $D=10$, $M=20$ width, and $L=2$ layers. The empirical histogram (blue) is perfectly fitted by the theoretical prediction from the Gaussian Orthogonal Ensemble (red curve, Equation[]~\eqref {eq:goe_ratio_dist}). This confirms that the NTK exhibits strong level repulsion characteristic of the GOE. The mode of the curve is at $r=1$, which is the expected value for the GOE. The reader can see that the curve put a hole exactly at the mode, further experiments have confirmed that adding the largest eigenvalue spacing ratios fill the hole since $\frac {\lambda _1-\lambda _2}{\lambda _2-\lambda _3}$ is very near to 1}{figure.caption.6}{}}
